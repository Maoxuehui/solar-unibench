# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.env

# Standardized dataset outputs (large; generated by the pipeline)
data/standardized/
data/raw/
*.zarr
*.parquet
!tests/**/*.parquet

# Experiment figures + result CSVs ARE tracked (publication deliverables):
# figures/ (dev) and figures_full/ (full-config) committed on request.

# Checkpoints / logs
*.log
audit.jsonl
manifest.json
checkpoints/
logs/

# Local session config
.claude/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local agent / tooling workspaces (not shared with the benchmark)
.superpowers/
.claude/
.raw_cache/
logs/
*.LAST_MEMBER
.fig6_lag_cache.npz
.closure_cache/

# upload chain runtime artifacts + local-only credential
scratch/
figures/dev/
closure_*.npy

# top-level dev scripts (untracked by design; public repo ships
# scripts/plots paper-figure scripts only)
dev/

# sample dataset IS tracked (exceptions to *.parquet/*.zarr rules)
!data/sample/**
data/sample/standardized_rebuild/
results/sample/

# internal working docs (Chinese experiment reports etc.)
docs/
data/sample/standardized_nb/
